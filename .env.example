# ============================================================
# BOT-KelatosNL — Dyson-lijn (Nederlandstalig), zelfde bedrijf Kelatos
# ============================================================

# WhatsApp API — NIET NODIG in deze opstelling.
# WhatsApp is rechtstreeks gekoppeld aan de nieuwe inbox in Chatwoot (Meta → Chatwoot),
# niet aan het eigen /webhook endpoint van deze bot. WHATSAPP_TOKEN en
# WHATSAPP_PHONE_NUMBER_ID mogen dus leeg blijven.
VERIFY_TOKEN=my_secret_verify_token_change_this

# Graph API version
GRAPH_API_VERSION=v22.0

# OpenAI (zelfde account kan hergebruikt worden)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4.1-mini

# Database (aparte lokale SQLite-file, ook al worden externe accounts gedeeld)
DATABASE_PATH=data/chat_history_nl.db

# Google Sheets (repair dashboard) — zelfde spreadsheet als de hoofdbot (gedeeld account)
GOOGLE_SHEETS_ID=your_google_sheet_id_here
# Google Sheets (prices — separate spreadsheet)
GOOGLE_PRICES_SHEET_ID=your_prices_sheet_id_here
GOOGLE_CREDENTIALS_PATH=credentials/service_account.json
SHEETS_CACHE_TTL=300

# Google Calendar — zelfde agenda als de hoofdbot (gedeeld account)
GOOGLE_CALENDAR_ID=soporte@kelatos.com
GOOGLE_CALENDAR_SUBJECT=soporte@kelatos.com

# Chatwoot
# Account/URL kunnen gedeeld zijn, maar een nieuw WhatsApp-nummer betekent een
# nieuwe inbox in Chatwoot → CHATWOOT_BOT_TOKEN is per inbox, dus dit moet een
# NIEUW Agent Bot-token zijn, ook al is het account hetzelfde.
CHATWOOT_URL=https://chat.affirmatechnology.com
CHATWOOT_BOT_TOKEN=your_new_nl_inbox_agent_bot_token_here
CHATWOOT_ADMIN_TOKEN=your_admin_token_here
CHATWOOT_ACCOUNT_ID=2
CHATWOOT_HANDOFF_AGENT_IDS=13,14

# EspoCRM (ACTIVO) — zelfde account/entity kan hergebruikt worden.
# Leads van deze bot worden geregistreerd als "WhatsApp NL - ..." om ze te
# onderscheiden van de Spaanstalige lijn.
ESPOCRM_URL=http://187.124.38.104:8080
ESPOCRM_API_KEY=your_espocrm_api_key_here
# Nombre interno de la entidad custom en EspoCRM donde se crean los registros.
ESPOCRM_ENTITY=CWTSBot
# Segundos a esperar desde el primer mensaje antes de volcar la conversacion a Espo (20 min = 1200).
ESPOCRM_LEAD_DELAY_SECONDS=1200
# Inactividad tras la cual un nuevo mensaje cuenta como conversacion nueva y crea otro lead (24 h = 86400).
ESPOCRM_NEW_LEAD_AFTER_SECONDS=86400

# Bot personality — de echte SYSTEM_PROMPT staat als default in config.py (Nederlands, Dyson-scope).
# Laat deze regel leeg/weg tenzij je bewust de default in config.py wilt overschrijven.
# SYSTEM_PROMPT=
